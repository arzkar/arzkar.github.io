---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.items && siteConfig.projects.items.length > 0;
---

{hasProjects && (
  <section id="projects" class="px-8 lg:px-12 py-14 border-b border-gray-100">
    <div class="flex items-center gap-4 mb-3">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-gray-400">Open-source & Tooling</span>
      <div class="flex-1 h-px bg-gray-100"></div>
    </div>

    <p class="text-[12px] text-gray-400 mb-8">{siteConfig.projects.intro}</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {siteConfig.projects.items.map((project, i) => {
        const demo = (project as any).demo as string | undefined;
        return (
          <div
            class="reveal group relative border border-gray-200 rounded-xl p-5 bg-white hover:shadow-md hover:border-gray-300 hover:-translate-y-0.5 transition-all duration-200"
            style={`transition-delay: ${i * 0.05}s`}
          >
            <!-- Header row -->
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-[13px] font-semibold text-gray-900 leading-snug">{project.name}</h3>
              <div class="flex items-center gap-2 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                    class="text-gray-400 hover:text-gray-700 transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>
                    </svg>
                  </a>
                )}
                {demo && (
                  <a
                    href={demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Live demo"
                    class="text-gray-400 hover:text-gray-700 transition-colors text-xs"
                  >
                    ↗
                  </a>
                )}
              </div>
            </div>

            <p class="mt-2 text-[12px] text-gray-500 leading-relaxed">{project.description}</p>

            {project.skills && project.skills.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1">
                {project.skills.map((skill) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 bg-gray-50 border border-gray-200 text-gray-500 rounded">
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>
)}
