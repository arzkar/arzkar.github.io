---
import { siteConfig } from "../config";
---

<section id="about" class="px-8 lg:px-12 py-14 border-b border-gray-100">
  <div class="flex items-center gap-4 mb-8">
    <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-gray-400">About</span>
    <div class="flex-1 h-px bg-gray-100"></div>
  </div>

  <div class="reveal text-base sm:text-lg leading-relaxed text-gray-600 space-y-4 max-w-[640px]">
    {siteConfig.aboutMe.split("\n\n").map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>

  <div class="reveal mt-8 flex flex-wrap gap-2">
    {siteConfig.skills.map((skill) => (
      <span class="px-2.5 py-1 text-[11px] font-mono border border-gray-200 text-gray-600 rounded-md hover:border-gray-400 hover:text-gray-800 transition-colors duration-150 cursor-default">
        {skill}
      </span>
    ))}
  </div>
</section>
