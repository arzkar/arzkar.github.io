---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects?.items?.length > 0;
const hasCaseStudies = siteConfig.caseStudies?.length > 0;
const hasExperience = siteConfig.experience?.length > 0;

---

<aside
  id="sidebar"
  class="hidden lg:flex flex-col w-[38%] min-w-[300px] max-w-[460px] h-screen sticky top-0 overflow-y-auto border-r border-gray-100 px-10 py-12 flex-shrink-0 scrollbar-hide"
>
  <!-- Identity -->
  <div>
    <p class="text-[10px] font-mono text-gray-400 uppercase tracking-[0.2em]">
      // {siteConfig.name.toLowerCase().replace(/\s+/g, '-')}
    </p>
    <h1 class="mt-3 text-[1.85rem] leading-tight font-bold text-gray-900 tracking-tight">
      {siteConfig.name}
    </h1>
    <p class="mt-1.5 text-[11px] font-mono uppercase tracking-[0.15em] text-gray-500">
      {siteConfig.title}
    </p>
    <p
      class="mt-5 text-[13px] sm:text-sm text-gray-600 leading-relaxed"
      style={`--accent-color: ${siteConfig.accentColor}`}
      set:html={siteConfig.tagline}
    />
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/resume"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 text-[11px] font-medium rounded-md border transition-all duration-200 hover:shadow-sm hover:-translate-y-px self-start"
        style={`border-color: ${siteConfig.accentColor}; color: ${siteConfig.accentColor};`}
      >
        View Resume
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </a>
      <div class="flex items-center gap-4">
        {siteConfig.social?.email && (
          <a href={`mailto:${siteConfig.social.email}`} aria-label="Email" class="text-gray-400 hover:text-gray-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
              <path d="M3 7l9 6l9 -6"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 hover:text-gray-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 hover:text-gray-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M8 11v5"/><path d="M8 8v.01"/><path d="M12 16v-5"/>
              <path d="M16 16v-3a2 2 0 1 0 -4 0"/>
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"/>
            </svg>
          </a>
        )}
        {siteConfig.social?.twitter && (
          <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="text-gray-400 hover:text-gray-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"/>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="mt-12 flex flex-col gap-0.5" aria-label="Page sections">
    <p class="mb-3 text-[10px] font-mono text-gray-300 uppercase tracking-[0.2em]">Navigate</p>
    <a href="#about" class="nav-link flex items-center gap-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors duration-150">
      <span class="nav-bar w-[3px] h-4 rounded-full bg-gray-200 transition-all duration-200"></span>
      About
    </a>
    {hasCaseStudies && (
      <a href="#case-studies" class="nav-link flex items-center gap-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors duration-150">
        <span class="nav-bar w-[3px] h-4 rounded-full bg-gray-200 transition-all duration-200"></span>
        Work
      </a>
    )}
    {hasExperience && (
      <a href="#experience" class="nav-link flex items-center gap-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors duration-150">
        <span class="nav-bar w-[3px] h-4 rounded-full bg-gray-200 transition-all duration-200"></span>
        Experience
      </a>
    )}
    {hasProjects && (
      <a href="#projects" class="nav-link flex items-center gap-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors duration-150">
        <span class="nav-bar w-[3px] h-4 rounded-full bg-gray-200 transition-all duration-200"></span>
        Open-source
      </a>
    )}
  </nav>

  <!-- Spacer -->
  <div class="flex-1 min-h-8"></div>

  <!-- Copyright -->
  <p class="text-[10px] font-mono text-gray-300">© {new Date().getFullYear()} {siteConfig.name}</p>
</aside>

<style>
  .nav-link:hover .nav-bar {
    background-color: rgb(156 163 175);
  }
  .nav-link.active {
    color: var(--accent-color);
    font-weight: 500;
  }
  .nav-link.active .nav-bar {
    background-color: var(--accent-color);
    height: 1.5rem;
  }
</style>
