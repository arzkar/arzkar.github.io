---
import { siteConfig } from "../config";
const hasCaseStudies = siteConfig.caseStudies && siteConfig.caseStudies.length > 0;
---

{hasCaseStudies && (
  <section id="case-studies" class="px-8 lg:px-12 py-14 border-b border-gray-100">
    <div class="flex items-center gap-4 mb-8">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-gray-400">Work</span>
      <div class="flex-1 h-px bg-gray-100"></div>
      <span class="text-[10px] font-mono text-gray-300">
        {siteConfig.caseStudies.length} {siteConfig.caseStudies.length === 1 ? 'case study' : 'case studies'}
      </span>
    </div>

    <div class="space-y-3">
      {siteConfig.caseStudies.map((study, i) => (
        <details
          class="reveal group border border-gray-200 rounded-xl overflow-hidden hover:border-gray-300 transition-colors duration-200 [&_summary::-webkit-details-marker]:hidden open:shadow-sm"
          style={`transition-delay: ${i * 0.06}s`}
        >
          <summary class="cursor-pointer list-none px-6 py-5 hover:bg-gray-50/60 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h3 class="text-[13px] font-semibold text-gray-900">{study.title}</h3>
                  {study.isPrivate && (
                    <span class="flex-shrink-0 text-[9px] font-mono px-2 py-0.5 border border-gray-200 text-gray-400 rounded">
                      private
                    </span>
                  )}
                </div>
                {study.companyUrl ? (
                  <a
                    href={study.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[11px] mt-0.5 inline-block hover:underline transition-colors"
                    style={`color: ${siteConfig.accentColor}`}
                    onclick="event.stopPropagation()"
                  >
                    {study.company} ↗
                  </a>
                ) : (
                  <p class="text-[11px] mt-0.5" style={`color: ${siteConfig.accentColor}`}>{study.company}</p>
                )}
              </div>
              <div class="flex items-center gap-3 flex-shrink-0">
                <span class="text-[10px] font-mono text-gray-400">{study.dateRange}</span>
                <span class="w-5 h-5 flex items-center justify-center text-gray-400 transition-transform duration-200 group-open:rotate-180">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </span>
              </div>
            </div>

            <!-- Challenge peek (hidden when open) -->
            <div class="group-open:hidden">
              <p class="mt-3 text-[12px] text-gray-500 leading-relaxed line-clamp-2">
                {study.problem.split("\n\n")[0].substring(0, 180)}…
              </p>
              <p class="mt-2 text-[11px] font-medium flex items-center gap-1" style={`color: ${siteConfig.accentColor}`}>
                Read full case study
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </p>
            </div>
          </summary>

          <!-- Expanded body -->
          <div class="px-6 pb-6 border-t border-gray-100">
            <!-- Tech chips at top for quick scan -->
            <div class="flex flex-wrap gap-1.5 py-4">
              {study.technologies.map((tech) => (
                <span class="px-2.5 py-1 text-[10px] font-mono bg-gray-50 border border-gray-200 text-gray-600 rounded-md">
                  {tech}
                </span>
              ))}
            </div>

            <div class="space-y-5">
              <div>
                <h4 class="text-[10px] font-mono uppercase tracking-[0.15em] text-gray-400 mb-2">Problem</h4>
                <div class="text-[12px] text-gray-600 leading-relaxed space-y-2">
                  {study.problem.split("\n\n").map((p) => <p>{p}</p>)}
                </div>
              </div>

              <div>
                <h4 class="text-[10px] font-mono uppercase tracking-[0.15em] text-gray-400 mb-2">Architecture</h4>
                <div class="text-[12px] text-gray-600 leading-relaxed space-y-2">
                  {study.architecture.split("\n\n").map((p) => <p>{p}</p>)}
                </div>
              </div>

              <div>
                <h4 class="text-[10px] font-mono uppercase tracking-[0.15em] text-gray-400 mb-2">Key Decisions</h4>
                <ul class="space-y-1.5">
                  {study.decisions.map((d) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 w-1 h-1 rounded-full bg-gray-400 flex-shrink-0"></span>
                      <span class="text-[12px] text-gray-600 leading-relaxed">{d}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h4 class="text-[10px] font-mono uppercase tracking-[0.15em] text-gray-400 mb-2">Outcome</h4>
                <p class="text-[12px] text-gray-600 leading-relaxed">{study.outcome}</p>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
