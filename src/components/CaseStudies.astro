---
import { siteConfig } from "../config";
const hasCaseStudies = siteConfig.caseStudies && siteConfig.caseStudies.length > 0;
---

{
  hasCaseStudies && (
    <section id="case-studies" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Work
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-6 text-base sm:text-lg text-gray-600 leading-relaxed">
              Production systems I've built and shipped. Architecture, decisions, and outcomes.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-gray-200 -translate-x-[29px] hidden lg:block" />
              <div class="space-y-16 pl-0 lg:pl-8">
                {siteConfig.caseStudies.map((study, index) => (
                  <article class="relative">
                    {/* Timeline dot */}
                    <div
                      class="absolute left-0 top-6 w-3 h-3 bg-white border-2 rounded-full -translate-x-[38px] z-20 hidden lg:block"
                      style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                    />

                  <details class="group bg-white rounded-xl border border-gray-200 [&_summary::-webkit-details-marker]:hidden open:shadow-xl transition-all duration-300">
                    <summary class="cursor-pointer list-none focus:outline-none p-6 sm:p-8 md:p-10 hover:bg-gray-50 transition-colors">
                      {/* Header */}
                      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                        <div class="flex-1 pr-4">
                          <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 group-hover:text-gray-700 transition-colors">
                            {study.title}
                          </h3>
                          {study.companyUrl ? (
                            <a
                              href={study.companyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-lg sm:text-xl hover:underline transition-colors relative z-10 inline-block"
                              style={`color: ${siteConfig.accentColor}`}
                              onclick="event.stopPropagation()"
                            >
                              {study.company}
                            </a>
                          ) : (
                            <p
                              class="text-lg sm:text-xl"
                              style={`color: ${siteConfig.accentColor}`}
                            >
                              {study.company}
                            </p>
                          )}
                        </div>
                        <div class="flex items-center gap-4 sm:flex-col sm:items-end sm:gap-2">
                          <span class="text-sm text-gray-500 font-mono">
                            {study.dateRange}
                          </span>
                          <span class="w-8 h-8 flex items-center justify-center rounded-full bg-white border border-gray-200 text-gray-500 shadow-sm group-hover:bg-gray-100 transition-all transform group-open:rotate-180 flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                          </span>
                        </div>
                      </div>

                      {study.isPrivate && (
                        <p class="text-sm text-gray-500 italic mt-4">
                          Codebase is private due to client confidentiality. Architecture and decisions shown reflect the production system.
                        </p>
                      )}

                      {/* Content Peek */}
                      <div class="mt-6 relative group-open:hidden">
                        <div class="text-base text-gray-600 leading-relaxed line-clamp-2 sm:line-clamp-3">
                          <span class="font-semibold text-gray-800 mr-2">The Challenge:</span>
                          {study.problem.split("\n\n")[0]}
                        </div>
                        <div class="absolute bottom-0 left-0 right-0 h-10 bg-gradient-to-t from-white group-hover:from-gray-50 to-transparent pointer-events-none"></div>
                      </div>
                      
                      <div class="mt-4 text-sm font-medium group-open:hidden flex items-center gap-1" style={`color: ${siteConfig.accentColor}`}>
                        Read full case study 
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </div>
                    </summary>

                    <div class="px-6 sm:px-8 md:px-10 pb-6 sm:pb-8 md:pb-10 pt-4 sm:pt-6 border-t border-gray-100 animate-in fade-in duration-300">
                      {/* Problem */}
                      <div class="mb-8">
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Problem</h4>
                        <div class="text-base text-gray-700 leading-relaxed space-y-4">
                          {study.problem.split("\n\n").map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                        </div>
                      </div>

                      {/* Architecture */}
                      <div class="mb-8">
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Architecture</h4>
                        <div class="text-base text-gray-700 leading-relaxed space-y-4">
                          {study.architecture.split("\n\n").map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                        </div>
                      </div>

                      {/* Key Decisions */}
                      <div class="mb-8">
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Key Decisions</h4>
                        <ul class="space-y-2">
                          {study.decisions.map((decision) => (
                            <li class="flex items-start">
                              <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                              <span class="text-base text-gray-700 leading-relaxed">
                                {decision}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      {/* Outcome */}
                      <div class="mb-6">
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Outcome</h4>
                        <p class="text-base text-gray-700 leading-relaxed">
                          {study.outcome}
                        </p>
                      </div>

                      {/* Technologies */}
                      <div>
                        <div class="flex flex-wrap gap-2">
                          {study.technologies.map((tech) => (
                            <span class="px-3 py-1 bg-gray-100 text-gray-800 rounded-md text-sm font-medium">
                              {tech}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </details>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

