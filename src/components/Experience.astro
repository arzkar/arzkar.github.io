---
import { siteConfig } from "../config";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;

const calculateDuration = (dateRange: string): string => {
  const monthMap: Record<string, number> = {
    Jan: 1, Feb: 2, Mar: 3, Apr: 4, May: 5, Jun: 6,
    Jul: 7, Aug: 8, Sep: 9, Oct: 10, Nov: 11, Dec: 12,
  };
  const parts = dateRange.split(" - ");
  if (parts.length !== 2) return "";
  const startStr = parts[0].trim();
  const endStr = parts[1].trim();
  const startMatch = startStr.match(/(\w+)\s+(\d{4})/);
  if (!startMatch) return "";
  const startMonth = monthMap[startMatch[1]];
  const startYear = parseInt(startMatch[2], 10);
  let endMonth: number, endYear: number;
  if (endStr.toLowerCase() === "present") {
    const now = new Date();
    endMonth = now.getMonth() + 1;
    endYear = now.getFullYear();
  } else {
    const endMatch = endStr.match(/(\w+)\s+(\d{4})/);
    if (!endMatch) return "";
    endMonth = monthMap[endMatch[1]];
    endYear = parseInt(endMatch[2], 10);
  }
  const totalMonths = (endYear - startYear) * 12 + (endMonth - startMonth);
  if (totalMonths <= 0) return "";
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;
  if (years === 0) return `${months}mo`;
  if (months === 0) return `${years}yr`;
  return `${years}yr ${months}mo`;
};
---

{hasExperience && (
  <section id="experience" class="py-14 border-b border-gray-100">

    <!-- Section header -->
    <div class="px-8 lg:px-12 flex items-center gap-4 mb-8">
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-gray-400">Experience</span>
      <div class="flex-1 h-px bg-gray-100"></div>
      <div class="flex items-center gap-1.5">
        <button
          id="exp-prev"
          class="p-1.5 rounded border border-gray-200 text-gray-400 hover:text-gray-700 hover:border-gray-300 transition-all text-xs leading-none disabled:opacity-30 disabled:cursor-not-allowed"
          aria-label="Previous"
          disabled
        >←</button>
        <button
          id="exp-next"
          class="p-1.5 rounded border border-gray-200 text-gray-400 hover:text-gray-700 hover:border-gray-300 transition-all text-xs leading-none"
          aria-label="Next"
        >→</button>
      </div>
    </div>

    <!-- Horizontal carousel -->
    <div
      id="exp-carousel"
      class="flex gap-4 overflow-x-auto scrollbar-hide scroll-smooth snap-x snap-mandatory px-8 lg:px-12"
    >
      {siteConfig.experience.map((exp, index) => {
        const duration = calculateDuration(exp.dateRange);
        return (
          <div
            class="exp-card reveal flex-shrink-0 w-[320px] sm:w-[360px] lg:w-[380px] snap-start bg-white border border-gray-200 rounded-xl p-6 hover:shadow-md hover:border-gray-300 transition-all duration-300"
            style={`transition-delay: ${index * 0.07}s`}
          >
            <!-- Card header -->
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-[13px] font-semibold text-gray-900 leading-snug">{exp.title}</h3>
                {exp.companyUrl ? (
                  <a
                    href={exp.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[11px] mt-1 inline-block hover:underline transition-colors"
                    style={`color: ${siteConfig.accentColor}`}
                  >
                    {exp.company} ↗
                  </a>
                ) : (
                  <p class="text-[11px] mt-1" style={`color: ${siteConfig.accentColor}`}>{exp.company}</p>
                )}
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-[10px] font-mono text-gray-400 whitespace-nowrap">{exp.dateRange}</p>
                {duration && (
                  <p class="text-[10px] font-mono text-gray-300 mt-0.5">{duration}</p>
                )}
              </div>
            </div>

            <div class="my-4 h-px bg-gray-100"></div>

            <ul class="space-y-2.5">
              {exp.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span
                    class="mt-2 w-1 h-1 rounded-full flex-shrink-0"
                    style={`background-color: ${siteConfig.accentColor}88`}
                  ></span>
                  <span class="text-[12px] text-gray-600 leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
      <!-- Trailing spacer so last card doesn't stick to edge -->
      <div class="flex-shrink-0 w-4 lg:w-8"></div>
    </div>

    <!-- Progress dots -->
    <div class="px-8 lg:px-12 flex items-center gap-1.5 mt-5">
      {siteConfig.experience.map((_, i) => (
        <button
          class="exp-dot rounded-full bg-gray-200 transition-all duration-200 cursor-pointer hover:bg-gray-400"
          style="width: 6px; height: 6px;"
          data-index={i}
          aria-label={`Go to experience ${i + 1}`}
        ></button>
      ))}
    </div>
  </section>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('exp-carousel') as HTMLElement | null;
    const prevBtn = document.getElementById('exp-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('exp-next') as HTMLButtonElement | null;
    const dots = document.querySelectorAll<HTMLElement>('.exp-dot');

    if (!carousel) return;

    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('.exp-card'));
    const total = cards.length;
    let current = 0;

    const scrollToCard = (index: number) => {
      const card = cards[index];
      if (!card) return;
      const carouselRect = carousel.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const paddingLeft = parseInt(getComputedStyle(carousel).paddingLeft) || 32;
      const newScrollLeft = carousel.scrollLeft + (cardRect.left - carouselRect.left) - paddingLeft;
      carousel.scrollTo({ left: newScrollLeft, behavior: 'smooth' });
    };

    const updateUI = () => {
      dots.forEach((dot, i) => {
        if (i === current) {
          dot.style.width = '18px';
          dot.style.backgroundColor = 'var(--accent-color)';
        } else {
          dot.style.width = '6px';
          dot.style.backgroundColor = '';
        }
      });
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
    };

    prevBtn?.addEventListener('click', () => {
      if (current > 0) { current--; scrollToCard(current); updateUI(); }
    });

    nextBtn?.addEventListener('click', () => {
      if (current < total - 1) { current++; scrollToCard(current); updateUI(); }
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { current = i; scrollToCard(i); updateUI(); });
    });

    // Sync dot to actual scroll
    let scrollTimeout: ReturnType<typeof setTimeout>;
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const carouselRect = carousel.getBoundingClientRect();
        let closest = 0;
        let minDist = Infinity;
        cards.forEach((card, i) => {
          const dist = Math.abs(card.getBoundingClientRect().left - carouselRect.left);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        current = closest;
        updateUI();
      }, 80);
    }, { passive: true });

    updateUI();
  });
</script>

<style>
  .exp-dot {
    transition: width 0.25s ease, background-color 0.25s ease;
  }
</style>
